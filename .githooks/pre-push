#!/bin/sh
# ══════════════════════════════════════════════════════════════
# กันแก้ของจริงตรงๆ — Under360 (นัทเคาะ 7 ส.ค. 2026 · แบบ C)
# หลัง beta launch: ลูกค้าจริงใช้ main อยู่
#
# กติกา: ห้ามยิง "โค้ดที่ไม่เคยผ่าน branch" ขึ้น main
#   ✅ ผ่าน  = commit นั้นเคยถูก push ขึ้น branch อื่นมาก่อนแล้ว (= มีลิงก์ Vercel ให้เทส)
#   ⛔ ไม่ผ่าน = commit ตรงบน main แล้วยิงเลย (ไม่มีใครได้เทส)
#
# 🚨 ช่องฉุกเฉิน: HOTFIX=1 git push ... (ลูกค้าเดือดร้อนอยู่เท่านั้น) แล้วแจ้งบอร์ดทันที
# ══════════════════════════════════════════════════════════════

REMOTE_NAME="$1"
[ -z "$REMOTE_NAME" ] && REMOTE_NAME=origin

ZERO=0000000000000000000000000000000000000000
BAD=""

while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  case "$REMOTE_REF" in
    refs/heads/main|refs/heads/master) ;;
    *) continue ;;
  esac
  [ "$LOCAL_SHA" = "$ZERO" ] && continue

  if [ "$REMOTE_SHA" = "$ZERO" ]; then
    RANGE="$LOCAL_SHA"
  else
    RANGE="$REMOTE_SHA..$LOCAL_SHA"
  fi

  # ไล่ทีละ commit ที่กำลังจะขึ้น main — ข้าม merge commit (ไม่มีโค้ดของตัวเอง)
  # ไฟล์ทั้งหมดที่กำลังจะขึ้น main รอบนี้ (ใช้ตัดสินว่าต้องรันเทสไหม)
  TOUCHED="$TOUCHED$(git diff --name-only "$RANGE" 2>/dev/null)
"
  for SHA in $(git rev-list --no-merges "$RANGE" 2>/dev/null); do
    # commit นี้เคยอยู่บน branch ไหนของ remote บ้าง (ไม่นับ main/master/HEAD)
    SEEN=$(git branch -r --contains "$SHA" 2>/dev/null \
           | sed 's/^[* ]*//' \
           | grep "^$REMOTE_NAME/" \
           | grep -vE "/(main|master|HEAD)$" \
           | head -1)
    if [ -z "$SEEN" ]; then
      BAD="$BAD  · $(git log -1 --pretty='%h %s' "$SHA" | cut -c1-72)
"
    fi
  done
done

# ── ด่านที่ 3: ไฟล์ที่ห้องอื่นจองไว้ = เตือน (23 ก.ย. 2569) ───────────────
# repo เดียว หลายห้องทำพร้อมกัน — การทับกันไม่ส่งเสียงเตือนเอง ต้องมีคนบอก
# ต่อเน็ตไม่ได้/ตารางล่ม = ข้ามไปเงียบ ๆ ไม่ขวางงาน
if [ -n "$TOUCHED" ] && [ -z "$SKIPCLAIM" ] && [ -f scripts/claim_warn.mjs ]; then
  printf %s "$TOUCHED" | node scripts/claim_warn.mjs 2>/dev/null
fi

# ── ด่านที่ 2: แตะไฟล์แกน = ต้องผ่านเทสก่อน (23 ก.ย. 2569) ─────────────
# ไฟล์พวกนี้พัง = ลูกค้าสั่งไม่ได้ / ครัวทำงานไม่ได้ / แอดมินทำงานไม่ได้
# เทสชุดนี้คือของที่เคยจับของพังมาแล้วหลายรอบ — ให้มันเฝ้าแทนความจำคน
CORE=$(printf %s "$TOUCHED" | grep -E "^(liff_customer\.html|operation_hub\.html|main_database_v2\.html|db2\.html|kitchen_queue\.html|home_editor\.html|print_pickslip\.html|gate\.js|vercel\.json|pwa/k2\.html|api/|scripts/u/)" | head -20)
if [ -n "$CORE" ] && [ -z "$SKIPTEST" ]; then
  echo ""
  echo "🧪 แตะไฟล์ที่ลูกค้า/ครัว/แอดมินใช้อยู่ — ขอรันเทสก่อน (ข้ามได้ด้วย SKIPTEST=1 ถ้ารันไปแล้ว)"
  printf %s "$CORE" | sed "s/^/   · /"
  echo ""
  if ! node scripts/u/run_all.mjs; then
    echo ""
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║  ⛔ เทสไม่ผ่าน — ยังขึ้น main ไม่ได้                          ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo "แก้ให้ผ่านก่อน หรือถ้าเทสเองผิด ให้แก้เทสพร้อมกันในคอมมิตเดียวกัน"
    echo "ด่วนจริงจนยอมเสี่ยง: HOTFIX=1 git push ... แล้วแจ้งบอร์ดทันที"
    echo ""
    exit 1
  fi
fi

[ -z "$BAD" ] && exit 0

if [ -n "$HOTFIX" ]; then
  echo ""
  echo "🚨 HOTFIX — ยอมให้ขึ้น main ตรง (โหมดฉุกเฉิน)"
  echo "   อย่าลืมแจ้งบอร์ดทันทีว่าแก้อะไร ทำไมถึงด่วน (กติกาข้อ C ที่นัทเคาะ)"
  echo ""
  exit 0
fi

echo ""
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║  ⛔ โค้ดนี้ยังไม่เคยผ่าน branch — ลูกค้าจริงใช้ main อยู่      ║"
echo "╚══════════════════════════════════════════════════════════════╝"
echo ""
echo "commit ที่ยังไม่เคยถูกเทสบน branch ไหนเลย:"
echo "$BAD"
echo "▸ วิธีที่ถูก (ก๊อปวางได้เลย)"
echo ""
echo "  git checkout -b fix/ชื่องานสั้นๆ"
echo "  git push -u origin HEAD"
echo "     → Vercel สร้างลิงก์ทดสอบของ branch นี้ให้เอง (ลูกค้าไม่เห็น) → เทสให้ผ่าน"
echo "  git checkout main && git merge fix/ชื่องานสั้นๆ && git push"
echo "  git branch -d fix/ชื่องานสั้นๆ"
echo ""
echo "▸ ด่วนจริง (ลูกค้าสั่งไม่ได้ / ของไม่ถึงมือลูกค้า / เงินคิดผิด)"
echo ""
echo "  HOTFIX=1 git push origin HEAD:main      แล้วแจ้งบอร์ดทันที"
echo ""
echo "▸ กติกาเต็ม: docs/BRANCH_RULES.md"
echo ""
exit 1
