#!/bin/sh
# ══════════════════════════════════════════════════════════════
# กันแก้ของจริงตรงๆ — Under360 (นัทเคาะ 7 ส.ค. 2026 · แบบ C)
# หลัง beta launch: ลูกค้าจริงใช้ main อยู่ → ห้ามยิงขึ้น main ตรงๆ
# ต้อง: แยก branch → เทสบนลิงก์ Vercel ของ branch → merge
#
# 🚨 ช่องฉุกเฉิน (แบบ C): ถ้าลูกค้าสั่งไม่ได้/ของจะไม่ถึงมือลูกค้า
#    ให้ใส่ HOTFIX=1 นำหน้าคำสั่ง push แล้วต้องแจ้งบอร์ดทันที
# ══════════════════════════════════════════════════════════════

BLOCKED=0
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  case "$REMOTE_REF" in
    refs/heads/main|refs/heads/master) BLOCKED=1 ;;
  esac
done

[ "$BLOCKED" = "0" ] && exit 0

if [ -n "$HOTFIX" ]; then
  echo ""
  echo "🚨 HOTFIX — ยอมให้ขึ้น main ตรง (โหมดฉุกเฉิน)"
  echo "   อย่าลืมแจ้งบอร์ดทันทีว่าแก้อะไร ทำไมถึงด่วน (กติกาข้อ C ที่นัทเคาะ)"
  echo ""
  exit 0
fi

cat <<'MSG'

╔══════════════════════════════════════════════════════════════╗
║  ⛔ ห้ามยิงขึ้น main ตรงๆ — ลูกค้าจริงใช้อยู่                  ║
╚══════════════════════════════════════════════════════════════╝

ตั้งแต่ beta launch (7 ส.ค. 2026) ทุกการแก้ต้องผ่าน branch ก่อน

▸ วิธีที่ถูก (ก๊อปวางได้เลย ทีละบรรทัด)

  git checkout -b fix/ชื่องานสั้นๆ
  git add ไฟล์ที่แก้
  git commit -m "ข้อความสั้นๆ ภาษาไทย"
  git push -u origin HEAD

  → Vercel จะสร้าง "ลิงก์ทดสอบ" ของ branch นี้ให้เอง (คนละลิงก์กับของจริง)
  → เปิดลิงก์นั้นบนมือถือ เทสให้ผ่านก่อน
  → ผ่านแล้วค่อย merge เข้า main แล้วลบ branch ทิ้ง

▸ ถ้าเป็นเรื่องด่วนจริง (ลูกค้าสั่งไม่ได้ / ของจะไม่ถึงมือลูกค้า)

  HOTFIX=1 git push origin HEAD:main

  แล้ว "ต้อง" แจ้งบอร์ดทันทีว่าแก้อะไร ทำไมถึงด่วน

▸ กติกาเต็ม: docs/BRANCH_RULES.md

MSG
exit 1
