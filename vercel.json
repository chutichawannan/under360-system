{
  "crons": [
    {
      "path": "/api/notify-mp-requests",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/mp-sync",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/health-critical",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/notify-kitchen-morning",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "staff.360foodbox.com"
        }
      ],
      "destination": "/staff/v2.html"
    },
    {
      "source": "/staff/v2",
      "destination": "/staff/v2.html"
    },
    {
      "source": "/staff/v2/home",
      "destination": "/staff/v2_home.html"
    },
    {
      "source": "/staff/v2/nut",
      "destination": "/staff/v2_nut.html"
    },
    {
      "source": "/staff/nut",
      "destination": "/staff/nut.html"
    },
    {
      "source": "/staff/looks",
      "destination": "/staff/looks.html"
    },
    {
      "source": "/staff",
      "destination": "/staff/index.html"
    },
    {
      "source": "/hq",
      "destination": "/pwa/hq.html"
    },
    {
      "source": "/k",
      "destination": "/pwa/app-k.html"
    },
    {
      "source": "/oh",
      "destination": "/pwa/app-oh.html"
    },
    {
      "source": "/money",
      "destination": "/pwa/cash_due.html"
    },
    {
      "source": "/ledger",
      "destination": "/pwa/money.html"
    },
    {
      "source": "/o",
      "destination": "/pwa/orders_upcoming.html"
    },
    {
      "source": "/cc",
      "destination": "/command_center.html"
    },
    {
      "source": "/kq",
      "destination": "/pwa/k2.html"
    },
    {
      "source": "/db",
      "destination": "/main_database_v2.html"
    },
    {
      "source": "/watchdog",
      "destination": "/pwa/watchdog.html"
    }
  ]
}
